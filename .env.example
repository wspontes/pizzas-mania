# Firebase (obtido no console do Firebase > Project settings > General > Your apps > Firebase SDK snippet > Config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin Service Account (apenas para /api/reset-password.mjs)
# Gere em: Project settings > Service accounts > Generate new private key
# Conteúdo do JSON em base64 (sem quebras de linha)
FIREBASE_SERVICE_ACCOUNT_B64=