rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function userRole() { return isAuth() && userDoc().data.role; }
    function userStore() { return isAuth() ? userDoc().data.storeId : null; }
    function isSuper() { return userRole() == 'superadmin'; }
    function isAdminOf(storeId) { return isSuper() || (isAuth() && userStore() == storeId); }

    // --- Stores (global) ---
    match /stores/{storeId} {
      allow read: if true;
      allow write: if isSuper();
    }

    // --- Tenant collections: stores/{storeId}/... ---
    match /stores/{storeId}/products/{doc} {
      allow read: if true;
      allow write: if isAdminOf(storeId);
    }
    match /stores/{storeId}/categories/{doc} {
      allow read: if true;
      allow write: if isAdminOf(storeId);
    }
    match /stores/{storeId}/settings/{doc} {
      allow read: if true;
      allow write: if isAdminOf(storeId);
    }
    match /stores/{storeId}/orders/{orderId} {
      allow read: if true;
      allow create: if true;
      allow update: if isAuth();
      allow delete: if false;
    }
    match /stores/{storeId}/coupons/{doc} {
      allow read: if true;
      allow write: if isAuth();
    }
    match /stores/{storeId}/analytics/{doc} {
      allow read: if true;
      allow update, create: if true;
    }
    match /stores/{storeId}/users/{userId} {
      allow read: if true;
      allow write: if isAuth();
    }
    match /stores/{storeId}/{document=**} {
      allow read, write: if isAuth();
    }

    // --- Legacy top-level collections (transicao) ---
    match /products/{doc} { allow read: if true; allow write: if isAuth(); }
    match /categories/{doc} { allow read: if true; allow write: if isAuth(); }
    match /settings/{doc} { allow read: if true; allow write: if isAuth(); }
    match /orders/{orderId} {
      allow read: if true; allow create: if true; allow update: if isAuth(); allow delete: if false;
    }
    match /coupons/{doc} { allow read: if true; allow write: if isAuth(); }
    match /analytics/{doc} { allow read: if true; allow update, create: if true; }
    match /users/{userId} { allow read: if true; allow write: if isAuth(); }
    match /motoboys/{doc} { allow read: if true; allow write: if isAuth(); }

    // Admin-only fallback
    match /{document=**} {
      allow read, write: if isAuth();
    }
  }
}