rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Permite ler usuários sem estar logado (para login por username)
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Demais coleções: só logado
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
